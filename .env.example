# =============================================================================
# Neon PostgreSQL (recommended)
# =============================================================================
# Get both URLs from: Neon Console → Project → Connect
#
# DATABASE_URL  = Pooled connection (host contains "-pooler") — use for the app
# DIRECT_URL    = Direct connection — use for Prisma migrations & db push
#
# Example:
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# Local PostgreSQL (optional fallback)
# =============================================================================
# DATABASE_URL=postgresql://flowdesk:flowdesk123@localhost:5432/flowdesk
# DIRECT_URL=postgresql://flowdesk:flowdesk123@localhost:5432/flowdesk

# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=24h

# Client (for CORS)
CLIENT_URL=http://localhost:5173

# Demo password (used in seed only)
DEMO_PASSWORD=FlowDesk@2026
